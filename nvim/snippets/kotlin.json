      "    }",
      "}",
      "",
      "/** Preview of the card. */",
      "@Preview(showBackground = true)",
      "@Composable",
      "private fun ${1:Item}CardPreview() {",
      "    MaterialTheme {",
      "        ${1:Item}Card(onClick = {})",
