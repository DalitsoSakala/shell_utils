    "description": "Create a LazyRow for horizontal lists"
  },
  "Scaffold Boilerplate": {
    "prefix": "scaffold",
    "body": [
      "Scaffold(",
      "    modifier = ${1:Modifier},",
      "    topBar = {",
      "        ${2:// TopBar}",
      "    },",
      "    bottomBar = {",
      "        ${3:// BottomBar}",
      "    },",
      "    floatingActionButton = {",
      "        ${4:// FloatingActionButton}",
      "    }",
      ") { innerPadding ->",
      "    Box(modifier = Modifier.padding(innerPadding)) {",
      "        $0",
      "    }",
      "}"
    ],
    "description": "Create a Scaffold template"
  },
