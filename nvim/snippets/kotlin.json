  "LazyColumn Layout": {
    "prefix": "lcol",
    "body": [
      "LazyColumn(",
      "    modifier = ${1:Modifier},",
      "    contentPadding = PaddingValues(${2:16.dp}),",
      "    verticalArrangement = Arrangement.spacedBy(${3:8.dp})",
      ") {",
      "    items(${4:itemsList}) { item ->",
      "        $0",
      "    }",
      "}"
    ],
    "description": "Create a LazyColumn for lists"
  },
  "LazyRow Layout": {
    "prefix": "lrow",
