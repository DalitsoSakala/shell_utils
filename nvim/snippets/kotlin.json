  "Domain Model": {
    "prefix": "compdomainmodel",
    "body": [
      "/**",
      " * Domain model for ${1:Item}.",
      " *",
      " * Pure data with no Room/Retrofit/Gson annotations, so it can be shared",
      " * freely between the data and presentation layers.",
      " */",
      "data class ${1:Item}(",
      "    val id: Long = 0,",
