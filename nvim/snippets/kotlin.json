  "Repository Interface (Domain)": {
    "prefix": "comprepository",
    "body": [
      "import kotlinx.coroutines.flow.Flow",
      "",
      "/**",
      " * Repository contract for ${1:Item} (domain layer).",
      " *",
      " * Screens and use cases depend on this interface rather than on a concrete",
      " * implementation, so the data source can be swapped without UI changes.",
      " */",
      "interface ItemRepository {",
      "    /** Emits the full collection and re-emits whenever the cache changes. */",
      "    fun get${1:Item}s(): Flow<${1:Item}>",
      "",
      "    /** Returns a single item by id, or null when it does not exist. */",
      "    suspend fun get${1:Item}ById(id: Long): ${1:Item}?",
      "",
      "    /** Inserts or replaces an item in the local cache. */",
      "    suspend fun upsert${1:Item}(item: ${1:Item})",
      "",
      "    /** Removes an item from the local cache. */",
      "    suspend fun delete${1:Item}(id: Long)",
      "}"
    ],
    "description": "Repository interface (domain layer)"
  },
  "Use Case": {
    "prefix": "compusecase",
    "body": [
      "import kotlinx.coroutines.flow.Flow",
      "import javax.inject.Inject",
      "import javax.inject.Singleton",
      "",
      "/**",
      " * Use case that observes the full collection.",
      " *",
      " * Use cases hold business logic and depend on a repository interface, which",
      " * keeps ViewModels lean. Call it directly: `getItemsUseCase()`.",
      " */",
      "@Singleton",
      "class Get${1:Item}sUseCase @Inject constructor(",
      "    private val repository: ItemRepository,",
      ") {",
      "    operator fun invoke(): Flow<${1:Item}> = repository.get${1:Item}s()",
      "}"
    ],
    "description": "Singleton use case injecting the repository"
  },
  "Room Entity": {
    "prefix": "compentity",
    "body": [
      "import androidx.room.ColumnInfo",
      "import androidx.room.Entity",
      "import androidx.room.PrimaryKey",
      "",
      "/**",
      " * Room entity persisting the ${1:Item} domain model to the item table.",
      " *",
      " * Keep the entity aligned with the domain model and map between the two",
      " * with the mappers generated by the compRepositoryImpl template.",
      " *",
      " * ── Migration checklist (required whenever fields change) ─────────────",
      " *   1. Bump the @Database version (e.g. 1 → 2); keep exportSchema = true",
      " *      so Room writes schema JSON under app/schemas/.",
      " *   2. Add a Migration in the database module:",
      " *        val MIGRATION_1_2 = object : Migration(1, 2) {",
      " *            override fun migrate(db: SupportSQLiteDatabase) {",
      " *                db.execSQL(\"ALTER TABLE item ADD COLUMN new_field TEXT\")",
      " *            }",
      " *        }",
      " *   3. Register it: Room.databaseBuilder(...).addMigrations(MIGRATION_1_2).",
      " *   4. Never rename/delete an existing column in place: Room verifies the",
      " *      schema on launch and throws IllegalStateException on any mismatch.",
      " */",
      "@Entity(tableName = \"item\")",
      "data class ItemEntity(",
      "    // Auto-generated surrogate primary key.",
      "    @PrimaryKey(autoGenerate = true)",
      "    @ColumnInfo(name = \"id\")",
      "    val id: Long = 0,",
      "",
      "    @ColumnInfo(name = \"title\")",
      "    val ${2:title}: String = \"\",",
      "",
      "    @ColumnInfo(name = \"description\")",
      "    val ${3:description}: String = \"\",",
      ")"
    ],
    "description": "Room entity with auto-generated primary key"
  },
  "Room DAO (Flow + upserts)": {
    "prefix": "compdao",
    "body": [
      "import androidx.room.Dao",
      "import androidx.room.Insert",
      "import androidx.room.OnConflictStrategy",
      "import androidx.room.Query",
      "import kotlinx.coroutines.flow.Flow",
      "",
      "/**",
      " * ┌────────────────────────────────┐",
      " * │           AppDatabase          │",
      " * │     (Room · owns the DAOs)     │",
      " * └───────────────┬────────────────┘",
      " *                 │ exposes the DAO instance",
      " *                 ▼",
      " * ┌────────────────────────────────┐",
      " * │     ItemDao  (@Dao)              │   ◄── this file",
      " * │  ── required types ─────────── │",
      " * │  • ItemEntity : Room row         │",
      " * │  • Flow<...> : reactive reads  │",
      " * └───────────────┬────────────────┘",
      " *                 │ observeAll() / getById() → Flow",
      " *                 ▼",
      " * ┌────────────────────────────────┐",
      " * │   ItemRepositoryImpl (Hilt)      │",
      " * │  ── required types ─────────── │",
      " * │  • ItemDao : local cache         │",
      " * │  • ItemApi : Retrofit sync       │",
      " * └───────────────┬────────────────┘",
      " *                 │ toDomain() / toEntity()",
      " *                 ▼",
      " * ┌────────────────────────────────┐",
      " * │  ItemRepository (domain)         │",
      " * │  consumed by ViewModel / UI    │",
      " * └────────────────────────────────┘",
      " *",
      " * Remote ──▶ Dto ──▶ Entity ──▶ Room ──▶ Flow ──▶ Domain ──▶ UI",
      " * (network only seeds/caches; the UI reads Room reactively)",
      " *",
      " * Room DAO for the ${1:Item} domain model (stored in the item table).",
      " *",
      " * Reads are exposed as [Flow] so the UI updates reactively whenever the",
      " * table changes. Writes use REPLACE conflict resolution.",
      " */",
      "@Dao",
      "interface ItemDao {",
      "    /** Emits the item with the given id (or null) on every change. */",
      "    @Query(\"SELECT * FROM item WHERE id = :id\")",
      "    fun getById(id: Long): Flow<ItemEntity?>",
      "",
      "    /** Emits the full collection, ordered by id, on every change. */",
      "    @Query(\"SELECT * FROM item ORDER BY id\")",
      "    fun observeAll(): Flow<List<ItemEntity>>",
      "",
      "    /** Inserts or replaces a single item. */",
      "    @Insert(onConflict = OnConflictStrategy.REPLACE)",
      "    suspend fun upsert(entity: ItemEntity)",
      "",
      "    /** Inserts or replaces a batch of items (used by network sync). */",
      "    @Insert(onConflict = OnConflictStrategy.REPLACE)",
      "    suspend fun upsertAll(entities: List<ItemEntity>)",
      "",
      "    /** Deletes the item with the given id. */",
      "    @Query(\"DELETE FROM item WHERE id = :id\")",
      "    suspend fun deleteById(id: Long)",
      "}"
    ],
    "description": "Room DAO with Flow-based reads and upserts"
  },
  "Retrofit DTO (Gson)": {
    "prefix": "compdto",
    "body": [
      "import com.google.gson.annotations.SerializedName",
      "",
      "/**",
      " * DTO (data transfer object) matching the remote ${1:Item} payload.",
      " *",
      " * Field names map to the server JSON with [SerializedName]. Keep it separate",
      " * from the domain model because server shapes change more often.",
      " */",
      "data class ItemDto(",
      "    @SerializedName(\"id\")",
      "    val id: Long,",
      "",
      "    @SerializedName(\"title\")",
      "    val ${2:title}: String?,",
      "",
      "    @SerializedName(\"description\")",
      "    val ${3:description}: String?,",
      ")"
    ],
    "description": "Retrofit DTO with Gson serialized names"
  },
  "Retrofit API Service": {
    "prefix": "compapi",
    "body": [
      "import retrofit2.http.Body",
      "import retrofit2.http.DELETE",
      "import retrofit2.http.GET",
      "import retrofit2.http.POST",
      "import retrofit2.http.Path",
      "",
      "/**",
      " * Retrofit service definition for the ${2:api/v1/items} resource.",
      " *",
      " * All methods are suspend functions, so the repository implementation can",
      " * call them directly inside its coroutines.",
      " */",
      "interface ItemApi {",
      "    /** Fetches the full collection. */",
      "    @GET(\"${2:api/v1/items}\")",
      "    suspend fun get${1:Item}s(): List<ItemDto>",
      "",
      "    /** Fetches a single item by id. */",
      "    @GET(\"${2:api/v1/items}/{id}\")",
      "    suspend fun get${1:Item}ById(@Path(\"id\") id: Long): ItemDto",
      "",
      "    /** Creates a new item server-side. */",
      "    @POST(\"${2:api/v1/items}\")",
      "    suspend fun create${1:Item}(@Body body: ItemDto): ItemDto",
      "",
      "    /** Deletes the item with the given id server-side. */",
      "    @DELETE(\"${2:api/v1/items}/{id}\")",
      "    suspend fun delete${1:Item}(@Path(\"id\") id: Long)",
      "}"
    ],
    "description": "Retrofit service interface (suspend endpoints)"
  },
  "Hilt Repository Impl (Room + Retrofit)": {
    "prefix": "comprepositoryimpl",
    "body": [
      "import javax.inject.Inject",
      "import javax.inject.Singleton",
      "import kotlinx.coroutines.flow.Flow",
      "import kotlinx.coroutines.flow.first",
      "import kotlinx.coroutines.flow.map",
      "",
      "/**",
      " * Offline-first implementation of the repository contract.",
      " *",
      " * Room is the single source of truth: reads stream from the local cache and",
      " * the network is only contacted to seed or refresh it. Dependencies are",
      " * injected by Hilt, so this class is never instantiated by hand.",
      " */",
      "@Singleton",
      "class ItemRepositoryImpl @Inject constructor(",
      "    private val dao: ItemDao,",
      "    private val api: ItemApi,",
      ") : ItemRepository {",
      "",
      "    // Stream straight from Room; reads never hit the network.",
      "    override fun get${1:Item}s(): Flow<${1:Item}> =",
      "        dao.observeAll().map { entities -> entities.map { it.toDomain() } }",
      "",
      "    override suspend fun get${1:Item}ById(id: Long): ${1:Item}? {",
      "        refreshIfEmpty()",
      "        return dao.getById(id).first()?.toDomain()",
      "    }",
      "",
      "    // Writes go to Room first, then trigger a best-effort network sync.",
      "    override suspend fun upsert${1:Item}(item: ${1:Item}) {",
      "        dao.upsert(item.toEntity())",
      "        refreshFromRemote()",
      "    }",
      "",
      "    override suspend fun delete${1:Item}(id: Long) {",
      "        dao.deleteById(id)",
      "    }",
      "",
      "    /** Pulls the remote collection and caches it locally. */",
      "    private suspend fun refreshFromRemote() {",
      "        runCatching { api.get${1:Item}s() }",
      "            .onSuccess { dtos -> dao.upsertAll(dtos.map { it.toEntity() }) }",
      "    }",
      "",
      "    /** Seeds the cache once when it is empty (for example, first launch). */",
      "    private suspend fun refreshIfEmpty() {",
      "        if (dao.observeAll().first().isEmpty()) refreshFromRemote()",
      "    }",
      "}",
      "",
      "/** Maps a remote DTO to a Room entity; nulls become empty strings. */",
      "fun ItemDto.toEntity(): ItemEntity = ItemEntity(",
      "    id = id,",
      "    ${2:title} = ${2:title}.orEmpty(),",
      "    ${3:description} = ${3:description}.orEmpty(),",
      ")",
      "",
      "/** Maps a Room entity to the domain model. */",
      "fun ItemEntity.toDomain(): ${1:Item} = ${1:Item}(",
      "    id = id,",
      "    ${2:title} = ${2:title},",
      "    ${3:description} = ${3:description},",
      ")",
      "",
      "/** Maps a domain model to a Room entity (for local writes). */",
      "fun ${1:Item}.toEntity(): ItemEntity = ItemEntity(",
      "    id = id,",
      "    ${2:title} = ${2:title},",
      "    ${3:description} = ${3:description},",
      ")"
    ],
    "description": "Hilt repository impl combining Room + Retrofit with mappers"
  },
  "Hilt ViewModel (MutableStateFlow)": {
    "prefix": "compviewmodel",
    "body": [
      "import androidx.lifecycle.ViewModel",
      "import androidx.lifecycle.viewModelScope",
      "import dagger.hilt.android.lifecycle.HiltViewModel",
      "import javax.inject.Inject",
      "import kotlinx.coroutines.flow.MutableStateFlow",
      "import kotlinx.coroutines.flow.StateFlow",
      "import kotlinx.coroutines.flow.asStateFlow",
      "import kotlinx.coroutines.flow.catch",
      "import kotlinx.coroutines.flow.onStart",
      "import kotlinx.coroutines.flow.update",
      "import kotlinx.coroutines.launch",
      "",
      "/**",
      " * ViewModel for the ${1:Item} screen, injected by Hilt.",
      " *",
      " * Exposes a single immutable [StateFlow] of the UI state; call [load] to",
      " * trigger a (re)load. Screens collect it with `collectAsStateWithLifecycle()`.",
      " */",
      "@HiltViewModel",
      "class ${1:Item}ViewModel @Inject constructor(",
      "    private val repository: ItemRepository,",
      ") : ViewModel() {",
      "",
      "    // Backing flow is private; the screen only ever sees the exposed copy.",
      "    private val _uiState = MutableStateFlow(ItemUiState())",
      "    val uiState: StateFlow<ItemUiState> = _uiState.asStateFlow()",
      "",
      "    init {",
      "        // Load immediately when the ViewModel is created.",
      "        load()",
      "    }",
      "",
      "    /** Loads the collection, tracking loading/error state in the UiState. */",
      "    fun load() {",
      "        viewModelScope.launch {",
      "            repository.get${1:Item}s()",
      "                .onStart { _uiState.update { it.copy(isLoading = true) } }",
      "                .catch { e -> _uiState.update { it.copy(isLoading = false, error = e.message) } }",
      "                .collect { data -> _uiState.update { it.copy(isLoading = false, data = data) } }",
      "        }",
      "    }",
      "}",
      "",
      "/** Immutable UI state consumed by the screen. */",
      "data class ItemUiState(",
      "    val isLoading: Boolean = false,",
      "    val data: List<${1:Item}> = emptyList(),",
      "    val error: String? = null,",
      ")"
    ],
    "description": "Hilt ViewModel exposing MutableStateFlow-based UiState"
  },
  "Compose Navigation Graph (Koin)": {
    "prefix": "compnavgraph",
    "body": [
      "import androidx.compose.runtime.Composable",
      "import androidx.compose.ui.Modifier",
      "import androidx.navigation.NavGraphBuilder",
      "import androidx.navigation.NavHostController",
      "import androidx.navigation.NavType",
      "import androidx.navigation.compose.NavHost",
      "import androidx.navigation.compose.composable",
      "import androidx.navigation.compose.rememberNavController",
      "import androidx.navigation.navArgument",
      "import org.koin.androidx.compose.viewModel",
      "",
      "/** Central place for route strings, shared by the graph and navigation calls. */",
      "object ${1:Home}Routes {",
      "    const val LIST = \"${2:home}\"",
      "    const val DETAIL = \"${3:detail}/{id}\"",
      "",
      "    /** Builds the detail route for a concrete id. */",
      "    fun detail(id: Long) = \"${3:detail}/\\$id\"",
      "}",
      "",
      "/**",
      " * Nestable graph builder: adds these destinations to any [NavHost].",
      " *",
      " * Two ways to use it:",
      " *  - Embed it inside another NavHost's builder lambda:",
      " *    `NavHost(...) { ${1:Home}Graph(navController) }`",
      " *  - Or register it as a nested graph with its own start destination:",
      " *    `navigation(startDestination = ${1:Home}Routes.LIST, route = \"${1:Home}Graph\") {",
      " *        ${1:Home}Graph(navController)",
      " *    }`",
      " * Each destination resolves its ViewModel through Koin with [viewModel],",
      " * which requires `koin-androidx-compose` and a started Koin app.",
      " *",
      " * Navigation architecture:",
      " *",
      " *  ┌─────────────────────────────────────┐",
      " *  │  ${1:Home}NavHost (@Composable)       │  ← root host used by setContent",
      " *  └───────────────────┬─────────────────┘",
      " *                      │ rememberNavController()",
      " *                      ▼",
      " *  ┌─────────────────────────────────────┐",
      " *  │  NavHost (startDestination = LIST)  │",
      " *  └───────────────────┬─────────────────┘",
      " *                      │ route strings from ${1:Home}Routes",
      " *                      ▼",
      " *  ┌─────────────────────────────────────┐",
      " *  │  LIST   : \"${2:home}\"            │",
      " *  │    HomeScreen ⇄ HomeViewModel (Koin)  │",
      " *  │         │ navigate(detail(id))      │",
      " *  │         ▼                           │",
      " *  │  DETAIL : \"${3:detail}/{id}\"     │",
      " *  │    HomeDetailScreen ⇄ HomeDetailViewModel (Koin) │",
      " *  └─────────────────────────────────────┘",
      " *",
      " * One destination = one route → composable → ViewModel. Routes are",
      " * centralized in ${1:Home}Routes so the graph and every navigation call",
      " * share a single source of truth.",
      " */",
      "fun NavGraphBuilder.${1:Home}Graph(",
      "    navController: NavHostController,",
      ") {",
      "    // List destination: the app entry point.",
      "    composable(route = ${1:Home}Routes.LIST) {",
      "        val listViewModel: HomeViewModel by viewModel()",
      "        HomeScreen(",
      "            onNavigateToDetail = { id -> navController.navigate(${1:Home}Routes.detail(id)) },",
      "        )",
      "    }",
      "    // Detail destination: receives its id as a typed navigation argument.",
      "    composable(",
      "        route = ${1:Home}Routes.DETAIL,",
      "        arguments = listOf(navArgument(\"id\") { type = NavType.LongType }),",
      "    ) {",
      "        val detailViewModel: HomeDetailViewModel by viewModel()",
      "        HomeDetailScreen(",
      "            onBack = { navController.popBackStack() },",
      "        )",
      "    }",
      "    $0",
      "}",
      "",
      "/**",
      " * Root host for standalone usage: `setContent { ${1:Home}NavHost() }`.",
      " *",
      " * For nesting, skip this host and call `${1:Home}Graph(navController)` inside a",
      " * larger NavHost instead.",
      " */",
      "@Composable",
      "fun ${1:Home}NavHost(",
      "    navController: NavHostController = rememberNavController(),",
      "    modifier: Modifier = Modifier,",
      ") {",
      "    NavHost(",
      "        navController = navController,",
      "        startDestination = ${1:Home}Routes.LIST,",
      "        modifier = modifier,",
      "    ) {",
      "        ${1:Home}Graph(navController)",
      "    }",
      "}"
    ],
    "description": "Nestable navigation graph wiring Koin ViewModels into Compose destinations"
  }
}
